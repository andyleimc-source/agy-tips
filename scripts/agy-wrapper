#!/bin/sh
# agy 的代理外壳 —— setup-agy.sh 把它装成 ~/.local/overrides/agy(排在 PATH 最前,盖住真二进制)。
#
# 干两件事:
#   1. 让 agy(且只让 agy)走自有硅谷出口 —— 见 agy-tunnel。机场 IP 是共用机房段,Google 判定飘忽,
#      同一轮里前几个请求成功、下一个就 "User location is not supported",整轮被掐断。
#      通道不在 → 退回机场 7897(能用,只是会偶发中断);都不在 → 裸连(会"每次重登")。
#   2. 默认注入 --dangerously-skip-permissions,已手动带则不重复。
#   3. 实例开太多时提前告警 —— 多实例会互相刷掉 OAuth token,见下面和 tips/15。
TUN=7899
AIRPORT=7897
P=""
if nc -z -G 1 127.0.0.1 "$TUN" 2>/dev/null; then
  P="socks5://127.0.0.1:$TUN"
elif nc -z -G 1 127.0.0.1 "$AIRPORT" 2>/dev/null; then
  P="http://127.0.0.1:$AIRPORT"
fi
if [ -n "$P" ]; then
  export http_proxy="$P" https_proxy="$P" all_proxy="$P"
  export HTTP_PROXY="$P" HTTPS_PROXY="$P" ALL_PROXY="$P"
  export no_proxy="localhost,127.0.0.1" NO_PROXY="localhost,127.0.0.1"
fi

# 并发实例告警 —— tips/15 的 401 根因。
# 每个 agy 实例都自带一个「每小时刷 OAuth token」的后台协程,而 token 全局只有一份
# (~/.gemini/antigravity-cli/antigravity-oauth-token)。开着一堆实例时,A 刷出的新 token
# 会把 B 手里那个作废,B 下一次调模型就吃
#   UNAUTHENTICATED (code 401): Request had invalid authentication credentials
# 而 agy 在 -p 模式下只打一句 "Agent execution terminated due to error",看着像断网。
_agy_live=$(pgrep -f "\.local/bin/agy .*--dangerously-skip-permissions" 2>/dev/null | wc -l | tr -d ' ')
if [ "${_agy_live:-0}" -ge 3 ]; then
  echo "⚠ 已经有 ${_agy_live} 个 agy 实例在跑,它们会互相刷掉对方的 OAuth token(报 401,长得像断网)。" >&2
  echo "  看一眼谁是僵尸:agy-ps    清掉:agy-ps -k" >&2
fi

# 真二进制:有的机器上 auto-updater 更新的是 agy-real,有的就叫 agy,两个都试。
REAL="$HOME/.local/bin/agy-real"
[ -x "$REAL" ] || REAL="$HOME/.local/bin/agy"
# 自指防护:万一本壳被装到了真二进制的位置,直接停,别递归把机器打爆。
case "$0" in "$REAL") echo "agy-wrapper: 装错位置了($0 == 真二进制路径),拒绝执行" >&2; exit 1 ;; esac

# 这几个子命令不注入任何 flag(与 .zshrc 里的 agy 函数保持一致)
case "${1:-}" in
  changelog|install|help|models|plugin|plugins|update) exec "$REAL" "$@" ;;
esac

# 3. 把当前目录钉成工作区。
# ⚠⚠ agy 在 -p(print/非交互)模式下**没有工作区**,默认落在
#   ~/.gemini/antigravity-cli/scratch —— 读不到项目的 AGENTS.md,也读不到
#   .agents/skills/,于是它一口咬定"我没有 mailroom 这个 skill",整轮空转**还不报错**。
#   实测:同一句话不加 --add-dir 答"没有",加了答"有"。
#   交互模式本来就认 cwd,重复钉一次无害,所以不分模式一律补,少一个要记的规矩。
ADD_DIR=""
case " $* " in
  *" --add-dir "*) ;;                     # 自己写了就不插手
  *) ADD_DIR="$PWD" ;;
esac

set -- ${ADD_DIR:+--add-dir "$ADD_DIR"} "$@"
case " $* " in
  *" --dangerously-skip-permissions "*) "$REAL" "$@" ;;
  *) "$REAL" --dangerously-skip-permissions "$@" ;;
esac
RC=$?

# 会话退出后后台异步汉化会话标题，不阻塞终端
( which agy-title-zh >/dev/null 2>&1 && agy-title-zh >/dev/null 2>&1 || "$HOME/dotfiles/bin/agy-title-zh" >/dev/null 2>&1 & )

exit $RC

